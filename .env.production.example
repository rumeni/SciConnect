# Copy to .env.production on the server, fill in every value, then:
#
#   chmod 600 .env.production
#   docker compose -f compose.prod.yaml --env-file .env.production up -d --build
#
# Keep this file off the laptop it was written on and out of git. Every value
# below is required: compose refuses to start rather than fall back to a default
# that is public knowledge.

# --- The domain -------------------------------------------------------------
# The name you bought, without a scheme and without a trailing slash. Its A
# record must already point at the server, or Caddy cannot get a certificate.
SITE_DOMAIN=example.org
# Where Let's Encrypt writes if a renewal is failing. A real inbox you read.
ACME_EMAIL=you@example.org

# --- The database -----------------------------------------------------------
POSTGRES_DB=sciconnect
POSTGRES_USER=sciconnect
# openssl rand -base64 36
POSTGRES_PASSWORD=

# --- Writing to the catalog -------------------------------------------------
# The secret that every POST and DELETE must carry. This is the only thing
# standing between the public internet and `DELETE /catalog/institutions/1`.
#
#   openssl rand -base64 48
#
# Paste it into the "Admin key" box under "Add & connect" when you want to
# change the catalog. The browser keeps it until the tab closes and never
# writes it to disk. Changing it here and restarting the API revokes it
# everywhere at once.
APP_ADMIN_TOKEN=

# --- Rate limits ------------------------------------------------------------
# Per client address, over a sliding window. Written as <count>/<period>, where
# the period is second, minute, hour or day. The defaults suit a public catalog
# browsed by people; raise the read limit if a legitimate integration polls.
APP_RATE_LIMIT_READ=120/minute
APP_RATE_LIMIT_WRITE=20/minute
# Each geocode spends an allowance on OpenStreetMap's shared service, so it is
# the tightest of the three.
APP_RATE_LIMIT_GEOCODE=10/minute
# Attempts at the admin key, right or wrong. Each one is a guess at the secret.
APP_RATE_LIMIT_AUTH=5/minute

# --- Optional ---------------------------------------------------------------
# Load the demo catalog on the first start against an empty database. Off here:
# a real site should not come up holding example data. Existing data is never
# touched either way.
APP_SEED_ON_STARTUP=false
# Institution addresses are turned into map coordinates once, on write, by
# calling OpenStreetMap. Set to false to store institutions without a position
# and make no outbound request.
APP_GEOCODING_ENABLED=true
