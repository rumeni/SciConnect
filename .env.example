POSTGRES_DB=sciconnect
POSTGRES_USER=sciconnect
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://sciconnect:change-me@db:5432/sciconnect
APP_ENV=development
APP_CORS_ORIGINS=["http://localhost:5173"]
# Load the demo catalog when the API starts against an empty database.
# Existing data is never modified. Set to false for an empty start.
APP_SEED_ON_STARTUP=true
# Institution addresses are looked up once, on write, to place them on a map.
# Set to false to store institutions without coordinates and make no outbound
# request. Point the user agent at your own deployment before real use.
APP_GEOCODING_ENABLED=true
APP_GEOCODING_USER_AGENT=SciConnect/0.1 (https://example.org/sciconnect)

