# Served by the production image. `${PORT}` is substituted at container start
# by the nginx image's own entrypoint, so the host can choose the port.

# Naming the version in every response tells an attacker which published
# vulnerabilities to try and tells a browser nothing it uses.
server_tokens off;

# nginx answers a directory request without its trailing slash with a redirect.
# Absolute, that redirect would name this container's own port (8080), which
# the browser cannot reach behind the proxy. Relative, it stays on the site.
absolute_redirect off;

server {
    listen      ${PORT};
    listen      [::]:${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json image/svg+xml;

    # This container serves static files only; a body of any size is a mistake
    # or a probe. Writes go to the API, through the front door, not through here.
    client_max_body_size 1m;

    # Asset filenames carry a content hash, so they never need revalidating.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The entry document and the runtime configuration change on every deploy.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store";
    }
    location = /config.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store";
    }

    # Nothing here is a dotfile worth serving, and some would be worth hiding.
    location ~ /\. {
        deny all;
    }

    # A single page application: anything unrecognised is still the app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
